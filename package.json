{
  "name": "n8n-nodes-hibira",
  "version": "0.1.0",
  "description": "n8n nodes for Hibira: publish realtime events and push notifications, and start workflows on Hibira webhooks (Pusher-compatible)",
  "license": "MIT",
  "homepage": "https://github.com/hibira-io/n8n-nodes-hibira#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "hibira",
    "pusher",
    "websocket",
    "realtime",
    "push-notifications",
    "webhooks"
  ],
  "author": {
    "name": "Hibira",
    "email": "support@hibira.io",
    "url": "https://hibira.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hibira-io/n8n-nodes-hibira.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/HibiraApi.credentials.js",
      "dist/credentials/HibiraPushApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Hibira/Hibira.node.js",
      "dist/nodes/HibiraTrigger/HibiraTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.54.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/hibira-io/n8n-nodes-hibira/issues"
  }
}
